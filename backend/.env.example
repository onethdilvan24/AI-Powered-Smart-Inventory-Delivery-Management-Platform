# Copy this file to .env and fill in your values

# Prisma Postgres connection string (from Prisma console / MCP)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Direct connection used only for migrations
DIRECT_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# JWT signing secret — use a long random string in production
JWT_SECRET="your-super-secret-key"
JWT_EXPIRES_IN="7d"

# Express server port
PORT=3001
NODE_ENV=development

# Frontend origin for CORS
CLIENT_URL="http://localhost:5173"

# Default seed accounts (password: password123)
# admin@foodflow.com  → ADMIN
# manager@foodflow.com → MANAGER
